{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sax-music-api",
  "main": "src/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "api.saxmusic.work",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2025-11-07",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sax-music-db",
      "database_id": "1a49308d-695f-4a1c-b749-2dd8cc6b8e2d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "sax-music"
    }
  ],
  "vars": {
    "R2_PUBLIC_URL": "https://hls.saxmusic.work"
  },
  "alias": {
    "@sinclair/typebox": "./node_modules/@sinclair/typebox",
    "@sinclair/typebox/value": "./node_modules/@sinclair/typebox/build/cjs/value",
    "@sinclair/typebox/compiler": "./node_modules/@sinclair/typebox/build/cjs/compiler",
    "@sinclair/typebox/system": "./node_modules/@sinclair/typebox/build/cjs/system"
  },
  "account_id": "06adb831a22b9b8824bea37e691cf101",
  "keep_vars": true
}
